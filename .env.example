# Phase 0 local-only runtime settings. Do not add cloud credentials here.
HOST=127.0.0.1
PORT=3000
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# The values below intentionally have no defaults. They are reserved for a
# future approved deployment flow and must be supplied by a secret manager, not
# committed to a local .env file or source control.
# FIREBASE_PROJECT_ID=
#
# Real Google Calendar (test integration). When BOTH are set, the worker's
# createCalendarPort() returns the real GoogleCalendarClient; otherwise it
# falls back to the in-memory fake, so an unconfigured environment never calls
# out. Point GOOGLE_CALENDAR_ID at a DEDICATED TEST calendar only, and inject
# the service-account JSON from a secret manager — never commit a key file.
# See docs/runbooks/calendar-go-live.md.
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
