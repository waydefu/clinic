# Phase 0 local-only runtime settings. Do not add cloud credentials here.
HOST=127.0.0.1
PORT=3000
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# A non-loopback API bind requires an explicit safety opt-in. Keep this disabled
# for the current local-only Stage 1 service.
# ALLOW_NON_LOOPBACK_BIND=false

# The values below intentionally have no defaults. They are reserved for a
# future approved deployment flow and must be supplied by a secret manager, not
# committed to a local .env file or source control.
# FIREBASE_PROJECT_ID=
#
# Real Google Calendar (test integration). It is disabled by default. The
# worker returns the real GoogleCalendarClient only when the mode is explicitly
# "test" and BOTH credential values are set. A partial or unexpected
# configuration fails closed instead of silently using the in-memory fake.
# Point GOOGLE_CALENDAR_ID at a DEDICATED TEST calendar only, and inject the
# service-account JSON from a secret manager — never commit a key file.
# See docs/runbooks/calendar-go-live.md.
# GOOGLE_CALENDAR_INTEGRATION_MODE=disabled
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
