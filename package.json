{
  "name": "beauessence-appointment-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise appointment platform workspace for Beau Essence Clinic.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "check:structure": "node scripts/check-structure.mjs",
    "check:ui": "node scripts/check-web-ui.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:format": "prettier --check .",
    "check:types": "corepack pnpm run build",
    "format": "prettier --write .",
    "test:unit": "vitest run --exclude tests/firestore/**",
    "test:rules": "node scripts/run-firestore-rules.mjs",
    "verify": "node scripts/check-structure.mjs && corepack pnpm run check:ui && corepack pnpm run check:docs && corepack pnpm run check:format && corepack pnpm run check:lint && corepack pnpm run check:types && corepack pnpm run test:unit",
    "check:lint": "eslint ."
  },
  "devDependencies": {
    "@beauessence/domain": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.7.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.0"
  }
}
