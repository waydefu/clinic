rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This platform has no client-to-Firestore data path.  The API service is
    // the sole write boundary, so direct browser/mobile reads and writes deny
    // by default until an ADR explicitly changes this rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
